{
    "name": "php-shop/backend",
    "description": "PHP API for php-shop (vanilla PHP, PSR-4 autoloading)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find classes -name '*.php' -exec php -l {} \\;"
    },
    "config": {
        "sort-packages": true
    }
}